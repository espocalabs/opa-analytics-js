{
	"name": "@opa.sh/analytics",
	"version": "0.3.1",
	"description": "Opa browser analytics SDK — first-party click attribution, identify/track, automatic pageview capture, outbound link decoration. Vanilla JS core with /react and /next subpaths.",
	"license": "MIT",
	"keywords": [
		"opa",
		"analytics",
		"attribution",
		"conversion-tracking",
		"tracker",
		"first-party",
		"react",
		"next",
		"nextjs"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/espocalabs/opa-analytics-js.git",
		"directory": "packages/analytics"
	},
	"homepage": "https://opa.sh/docs/sdks/conversions",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"bun": "./src/react/index.ts",
			"import": {
				"types": "./dist/react/index.d.ts",
				"default": "./dist/react/index.js"
			},
			"require": {
				"types": "./dist/react/index.d.cts",
				"default": "./dist/react/index.cjs"
			}
		},
		"./next": {
			"bun": "./src/next/index.ts",
			"import": {
				"types": "./dist/next/index.d.ts",
				"default": "./dist/next/index.js"
			},
			"require": {
				"types": "./dist/next/index.d.cts",
				"default": "./dist/next/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup src/index.ts src/react/index.ts src/next/index.ts --format esm,cjs --dts --clean --external react --external react-dom --external next",
		"build:sdk": "bun run scripts/build-sdk.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check ."
	},
	"peerDependencies": {
		"next": "^16",
		"react": "^18 || ^19"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"esbuild": "^0.28.1",
		"happy-dom": "^20.11.1",
		"next": "^16.3.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tsup": "^8.5.0",
		"typescript": "^6.0.3"
	}
}
