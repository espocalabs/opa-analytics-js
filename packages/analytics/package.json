{
	"name": "@opa.sh/analytics",
	"version": "0.1.0",
	"description": "Opa browser analytics SDK — first-party click attribution, identify/track, outbound link decoration.",
	"license": "MIT",
	"keywords": [
		"opa",
		"analytics",
		"attribution",
		"conversion-tracking",
		"tracker",
		"first-party"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/espocalabs/opa-analytics-js.git",
		"directory": "packages/analytics"
	},
	"homepage": "https://opa.sh/docs/sdks/conversions",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean",
		"build:sdk": "bun run scripts/build-sdk.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"esbuild": "^0.28.1",
		"tsup": "^8.5.0",
		"typescript": "^6.0.3"
	}
}
