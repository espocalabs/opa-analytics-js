{
	"name": "@opa.sh/analytics-react",
	"version": "0.1.1",
	"description": "React bindings for Opa analytics — <OpaProvider>, useOpa(), and <OpaAnalytics>.",
	"license": "MIT",
	"keywords": [
		"opa",
		"analytics",
		"react",
		"attribution",
		"conversion-tracking"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/espocalabs/opa-analytics-js.git",
		"directory": "packages/analytics-react"
	},
	"homepage": "https://opa.sh/docs/sdks/conversions",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"src"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup src/index.ts --format esm,cjs --dts --clean --external react --external @opa.sh/analytics",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check ."
	},
	"peerDependencies": {
		"react": "^18 || ^19"
	},
	"dependencies": {
		"@opa.sh/analytics": "workspace:*"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.11.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"happy-dom": "^20.11.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tsup": "^8.5.0",
		"typescript": "^6.0.3"
	}
}
